{
  "name": "@forms/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Results aggregation: SQL over JSONB for one form version, and the arithmetic (NPS, medians, histograms) on the counts it returns.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@forms/shared": "workspace:*"
  },
  "devDependencies": {
    "@forms/config": "workspace:*",
    "@types/node": "^20.17.6",
    "fast-check": "^3.23.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}

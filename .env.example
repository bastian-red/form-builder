# form-builder environment.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_SECRET=|AUTH_SECRET=$(openssl rand -base64 32)|" .env
#
# Every name here is declared in turbo.json. That is not a convention, it is a
# gate: `node scripts/env-contract.mjs` fails the commit if this file, the source
# and turbo.json disagree in any of four directions. Turborepo 2 runs in strict
# environment mode, so a name turbo.json forgets is stripped from the child
# process silently and the app boots misconfigured rather than loudly broken.
#
# Nothing loads this file on its own. `pnpm dev` runs scripts/dev.sh, which
# sources it, checks AUTH_SECRET and preflights the datastores before handing off
# to turbo.

# --- Core ---

# Next.js and Nest read this themselves. Leave it unset for local development;
# `next build` must not see "development" or it pulls the dev React runtime and
# prerendering breaks.
NODE_ENV=

# Reported by /health so a running process can be identified.
APP_VERSION=0.1.0

# --- Database (Postgres) ---

# Ports are deliberately off the defaults. The dev host runs a system PostgreSQL
# on 5432 and the sibling portfolio stacks own 5433-5440 and 6380-6386, so this
# project takes 5441/6387 and every URL below matches.
DATABASE_URL=postgresql://forms:forms@localhost:5441/forms?schema=public

# Prisma migrations cannot run through a transaction-mode pooler. Locally this is
# the same server; the two names exist so the split is possible without a code
# change.
DIRECT_DATABASE_URL=postgresql://forms:forms@localhost:5441/forms?schema=public

# --- Redis ---

# Two jobs, both rebuildable: the rate-limit counters (shared across API replicas,
# so a limit is one limit and not one per process) and the results cache. Losing
# it costs one slow results page and nothing else.
REDIS_URL=redis://localhost:6387

# --- API service ---

API_PORT=4000

# PORT wins over API_PORT, matching what every container runtime injects. Leave it
# empty locally: the web app reads PORT too.
PORT=

# Where the web app's server components and server actions reach the API.
# Server-side only, so it stays a container name in Docker. The browser never
# calls the API: there is no NEXT_PUBLIC_ API URL, no CORS surface, and no service
# token in browser JavaScript.
API_BASE_URL=http://localhost:4000

# --- Web app ---

WEB_PORT=3000

# This app's own origin. Public form links (/f/<slug>) are built on it.
APP_BASE_URL=http://localhost:3000

# --- Auth ---

# One value, two processes: the web app mints a short-lived HS256 service token
# with it and the API verifies it. At least 16 characters; scripts/dev.sh refuses
# to start without one.
AUTH_SECRET=

# Auth.js reads this directly to build callback URLs.
AUTH_URL=http://localhost:3000

# --- Responses ---

# The largest answers object one save may carry, in bytes of JSON. A long-text
# answer is capped at 5,000 characters by the schema; this is the backstop for a
# client that ignores the schema and posts a megabyte.
MAX_ANSWERS_BYTES=65536

# Rows per page in the results' response table.
RESPONSES_PAGE_SIZE=50

# How long an aggregated results payload stays in Redis. The cache key already
# changes when any response is saved, so this is only a memory bound, never a
# staleness bound.
RESULTS_CACHE_TTL_SECONDS=600

# --- HTTP rate limits (requests per minute, per client address) ---

# The auth budget must stay below the global one or apps/api/src/config/boot.ts
# refuses to start, because a larger auth budget is always a mistake rather than
# a choice.
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5

# Public form routes. Each answered question is one save, so a 20-question form
# filled honestly is about 25 requests; 120 leaves room for a slow typist on a
# flaky connection and still stops a script.
RATE_LIMIT_RESPOND=120

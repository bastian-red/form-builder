// form-builder schema (docs/SPECS.md 5).
//
// Three things about this file are load-bearing and are explained where they
// appear rather than here:
//
//   1. A form is TWO documents: `forms.draft`, overwritten as the author edits,
//      and `form_versions.definition`, an immutable snapshot cut by publishing.
//      Responses point at a version, never at the form's draft, so editing a
//      question can never change what an old response meant.
//   2. `responses.id` is generated by the respondent's browser. That is what
//      makes a retried save idempotent: the same id twice is the same row, by
//      primary key, under any concurrency.
//   3. Everything Prisma cannot express (CHECK constraints, the GIN index with
//      its operator class) lives in migrations/*_form_invariants, and the
//      constraint NAMES are exported from src/constraints.ts so catch blocks
//      match on a name rather than on message text.
//
// `prisma migrate dev` is deliberately `--create-only` in package.json, so a
// generated migration is reviewed before it can drop a hand-written constraint.

generator client {
  // Generated INTO the package, not into node_modules. `pnpm deploy --prod` in a
  // Docker build rebuilds node_modules and drops a client generated there, and
  // the failure appears only in the image.
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations cannot run through a transaction-mode pooler. Locally both names
  // point at the same server; the split exists so it can be made without a code
  // change.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique(map: "users_email_key")
  name         String
  /// scrypt, `@forms/shared/server`'s hashPassword. Never returned by any route.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  forms Form[]

  @@map("users")
}

model Form {
  id      String @id @default(cuid())
  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// What `/f/<slug>` carries. Random at creation and never changed, so a link
  /// already printed on a poster keeps working through every edit and version.
  slug String @unique(map: "forms_slug_key")

  /// The draft's title, denormalised so the form list is one indexed query
  /// rather than a JSONB read per row. Written in the same UPDATE as the draft.
  title String

  /// The working copy. Validated as a FormDefinition on every write; may be
  /// logically wrong (a dangling jump) while being edited.
  draft Json

  /// Optimistic concurrency for the draft: a save names the revision it was
  /// based on and is refused if another tab saved in between.
  draftRevision Int @default(0) @map("draft_revision")

  /// Closed forms answer 410 to respondents. Responses already stored stay.
  accepting Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  versions  FormVersion[]
  responses Response[]

  @@index([ownerId, updatedAt(sort: Desc)], map: "forms_owner_updated_idx")
  @@map("forms")
}

model FormVersion {
  id     String @id @default(cuid())
  formId String @map("form_id")
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  /// 1-based and gapless per form, allocated as max + 1 inside the publish
  /// transaction; the unique index turns a concurrent double-publish into a
  /// conflict instead of two "version 3"s.
  version Int

  /// The immutable snapshot. Nothing UPDATEs this column.
  definition Json

  publishedAt DateTime @default(now()) @map("published_at")

  responses     Response[]
  stats         VersionStats?
  fieldStats    FieldStats[]
  answerStats   AnswerStats[]
  durationStats DurationStats[]

  @@unique([formId, version], map: "form_versions_form_id_version_key")
  /// Target of `Response.formVersion`'s composite key, which pins a response's
  /// form and its version's form to be the same form.
  @@unique([id, formId], map: "form_versions_id_form_id_key")
  @@map("form_versions")
}

model Response {
  /// A v4 UUID minted by the respondent's browser. See note 2 at the top.
  id            String      @id @db.Uuid
  formId        String      @map("form_id")
  form          Form        @relation(fields: [formId], references: [id], onDelete: Cascade)
  formVersionId String      @map("form_version_id")
  /// Composite on purpose: (form_version_id, form_id) -> form_versions (id,
  /// form_id). Without it a response could be filed under one form while pinned
  /// to another form's version, and the first form's results would count the
  /// second's answers.
  formVersion   FormVersion @relation(fields: [formVersionId, formId], references: [id, formId], onDelete: Cascade, map: "responses_version_belongs_to_form")

  /// Field id to value, normalized and validated against `formVersion` by the
  /// server-side walk. Only answers on the respondent's path are ever stored.
  answers Json @default("{}")

  /// The fields the respondent's path has shown so far, computed by the SERVER
  /// from the answers. The funnel counts `unnest(reached)`.
  reached String[] @default([])

  startedAt   DateTime  @default(now()) @map("started_at")
  updatedAt   DateTime  @default(now()) @map("updated_at")
  /// Null while in progress. Once set, the row is never written again.
  submittedAt DateTime? @map("submitted_at")

  @@index([formVersionId, submittedAt], map: "responses_version_submitted_idx")
  @@index([formVersionId, updatedAt], map: "responses_version_updated_idx")
  /// The results filter: `answers @> '{"f_x":"o_y"}'`. jsonb_path_ops is smaller
  /// and faster than the default class and supports exactly @>, the only
  /// operator the filter uses.
  @@index([answers(ops: JsonbPathOps)], type: Gin, map: "responses_answers_gin")
  @@map("responses")
}

// --- Results counters ------------------------------------------------------------
//
// The report reads these instead of scanning responses, so an unfiltered results
// page costs O(distinct answers), not O(responses) (docs/SPECS.md 7). They are
// written in the SAME transaction as the response they count
// (apps/api/src/respond/respond.service.ts), from deltas computed by
// `responseDeltas` in services/analytics, and can always be rebuilt from the
// responses by `recount` -- the integration lane asserts the two agree after
// concurrent traffic, which is the proof they do not drift.

/// Per version: responses started (any save) and completed.
model VersionStats {
  formVersionId String      @id @map("form_version_id")
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  started       Int         @default(0)
  completed     Int         @default(0)

  @@map("version_stats")
}

/// Per field: how many responses reached it (all, and completed), and how many
/// completed responses answered it.
model FieldStats {
  formVersionId    String      @map("form_version_id")
  formVersion      FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  fieldId          String      @map("field_id")
  reachedAll       Int         @default(0) @map("reached_all")
  reachedCompleted Int         @default(0) @map("reached_completed")
  answered         Int         @default(0)

  @@id([formVersionId, fieldId])
  @@map("field_stats")
}

/// Per categorical answer value of completed responses. A multi-choice
/// selection counts once per option chosen. Free text is never counted here.
model AnswerStats {
  formVersionId String      @map("form_version_id")
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  fieldId       String      @map("field_id")
  value         Json
  count         Int         @default(0)

  @@id([formVersionId, fieldId, value])
  @@map("answer_stats")
}

/// Completed responses by whole seconds from first save to submission; the
/// median is computed exactly from these counts.
model DurationStats {
  formVersionId String      @map("form_version_id")
  formVersion   FormVersion @relation(fields: [formVersionId], references: [id], onDelete: Cascade)
  seconds       Int
  count         Int         @default(0)

  @@id([formVersionId, seconds])
  @@map("duration_stats")
}
